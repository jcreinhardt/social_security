# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.python-version
.venv/
venv/
env/

# Data and output — collaborate via Dropbox, not git
# (use data/* not data/ so the README can be re-included; git can't negate a
#  file whose parent directory is wholesale-ignored)
data/*
output/*
!data/.gitkeep
!output/.gitkeep
!data/README.md
!output/README.md
# Track the small (~44 KB) Guvenen moment targets so the run scripts have them
# after a plain `git pull` (raw inputs like *.xls stay ignored).
!data/intermediate/
data/intermediate/*
!data/intermediate/*.dat
# Frozen single-sex (men/women) targets collapsed from the GKOS workbooks
# (~34 KB each) — committed so the cluster gender run needs neither the heavy
# .xlsx nor openpyxl. Produced by code/freeze_gender_targets.py.
!data/gender_targets/
data/gender_targets/*
!data/gender_targets/*.npz

# Scratch / session working files — never committed
scratch/

# macOS zip metadata
__MACOSX/

# Logs
*.log

# earning_dynamics — code only; data/output via Dropbox
earning_dynamics/data/
earning_dynamics/output/

# guvenen_2021_replication — drop heavy/regeneratable artifacts
guvenen_2021_replication/14603_Data_and_Programs.zip
guvenen_2021_replication/14603_Data_and_Programs/submission/PSID programs/Intermediate/
guvenen_2021_replication/14603_Data_and_Programs/submission/PSID programs/Output/
guvenen_2021_replication/14603_Data_and_Programs/submission/PSID programs/LogFiles/
guvenen_2021_replication/14603_Data_and_Programs/submission/GKOS_2021_replication.xlsx
guvenen_2021_replication/targeted_moments_stata/do/
guvenen_2021_replication/targeted_moments_stata/dta/
guvenen_2021_replication/targeted_moments_stata/out/
guvenen_2021_replication/targeted_moments_stata/log/
